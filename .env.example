# Copie este arquivo para .env. Não commite segredos reais.
SECRET_KEY="gere-uma-chave-aleatoria-para-este-ambiente"
GOOGLE_CLIENT_ID="776335673676-dk7od4ljhh43bio4bppf94i8ou0u9v9i.apps.googleusercontent.com"
GEMINI_TIMEOUT_SECONDS=60
GEMINI_API_KEY=""
OPEN_ELEVATION_API_KEY=""
OVERPASS_URL="https://overpass-api.de/api/interpreter"
# URL base de produção dos webhooks do n8n (termina em /webhook; vazio ativa modo local)
N8N_WEBHOOK_BASE_URL=""
# Segredo compartilhado enviado no cabeçalho X-Webhook-Secret nas chamadas ao n8n
N8N_WEBHOOK_SECRET=""
# Timeout em segundos das chamadas HTTP enviadas ao n8n
N8N_TIMEOUT_SECONDS=3
# Chave exigida no cabeçalho X-Support-Key em /api/v1/suporte/* (vazio retorna 503)
SUPPORT_API_KEY=""
# Ambiente da aplicação enviado no campo environment da DLQ (local, staging ou production)
APP_ENV="local"
